# PrintLab Studio – tijdelijke HTTP configuratie

RewriteEngine On

# HTTPS-redirect tijdelijk uitgeschakeld.
# Cloudflare/SSL is nog niet actief.

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# --- CORS voor PrintLab Studio ? preview.php ---
<IfModule mod_headers.c>
  # Preflight (OPTIONS)
  SetEnvIf Origin "^https?://studio\.printlabnl\.nl$" CORS_ALLOW_ORIGIN=$0
  Header always set Access-Control-Allow-Origin "%{CORS_ALLOW_ORIGIN}e" env=CORS_ALLOW_ORIGIN
  Header always set Access-Control-Allow-Methods "POST, OPTIONS" env=CORS_ALLOW_ORIGIN
  Header always set Access-Control-Allow-Headers "Content-Type, Accept" env=CORS_ALLOW_ORIGIN
  Header always set Access-Control-Max-Age "86400" env=CORS_ALLOW_ORIGIN
  Header always set Vary "Origin"
</IfModule>

# OPTIONS-requests op preview.php met 204 beantwoorden
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteCond %{REQUEST_URI} preview\.php$ [NC]
RewriteRule ^ - [R=204,L]